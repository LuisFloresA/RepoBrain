# Copiar a .env.prod en la raíz del repo de la VM antes de levantar
# docker-compose.prod.yml. El stack arranca igual sin este archivo
# (repos públicos + LLM mock).
#
# IMPORTANTE: no subir nunca este archivo al repositorio.

# Proveedor LLM: mock | openai | deepseek | gemini | ollama
# LLM_PROVIDER=deepseek
# LLM_API_KEY=sk-...
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com/v1